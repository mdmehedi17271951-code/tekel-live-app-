{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile representation in Tekel Live",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name in Bengali or English", "maxLength": 100 },
        "username": { "type": "string", "description": "Unique username handle", "pattern": "^[a-zA-Z0-9_]{3,30}$" },
        "photoURL": { "type": "string", "description": "Profile picture URL" },
        "bio": { "type": "string", "description": "Profile bio description", "maxLength": 500 },
        "coverURL": { "type": "string", "description": "Cover banner image URL" },
        "followersCount": { "type": "number", "description": "Total followers count" },
        "followingCount": { "type": "number", "description": "Total following count" },
        "postsCount": { "type": "number", "description": "Total posts created count" },
        "role": { "type": "string", "enum": ["user", "admin", "moderator"] },
        "isBanned": { "type": "boolean", "description": "Account suspension status" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "username"]
    },
    "Post": {
      "title": "Post",
      "description": "Social media post containing text, photo, or video",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "authorUsername": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "photo", "video"] },
        "content": { "type": "string", "maxLength": 2000 },
        "mediaUrl": { "type": "string" },
        "videoUrl": { "type": "string" },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "sharesCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "type"]
    },
    "Comment": {
      "title": "Comment",
      "description": "User comment on a post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "postId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "text": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "authorId", "text"]
    },
    "Follow": {
      "title": "Follow",
      "description": "Follower-following relationship",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "followerId": { "type": "string" },
        "followingId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["followerId", "followingId"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Direct message chat between users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participants": { "type": "array" },
        "lastMessage": { "type": "string" },
        "lastMessageTime": { "type": "string", "format": "date-time" }
      },
      "required": ["participants"]
    },
    "Message": {
      "title": "Message",
      "description": "Individual chat message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string", "maxLength": 2000 },
        "mediaUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["conversationId", "senderId", "text"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification event",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipientId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderPhoto": { "type": "string" },
        "type": { "type": "string", "enum": ["like", "comment", "follow", "message", "admin"] },
        "targetId": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recipientId", "senderId", "type"]
    },
    "SavedPost": {
      "title": "SavedPost",
      "description": "Bookmarked post saved by user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "postId": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Public user profiles"
    },
    "/users/{userId}/savedPosts/{postId}": {
      "schema": "SavedPost",
      "description": "Bookmarked posts saved by the user"
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "User published feed posts"
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Comments attached to posts"
    },
    "/posts/{postId}/likes/{userId}": {
      "schema": "Like",
      "description": "Likes associated with posts"
    },
    "/follows/{followId}": {
      "schema": "Follow",
      "description": "User follow associations"
    },
    "/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Chat conversations"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages in conversation"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications"
    }
  }
}
